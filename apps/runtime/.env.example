# Обов'язковий filesystem path до каталогу metadata для Vite dev server
SIMETRA_METADATA_PATH=/absolute/path/to/project/metadata

# Обов'язковий browser path, за яким runtime fetch-ить metadata JSON
VITE_SIMETRA_METADATA_PATH=/metadata

# Data provider для runtime: mock або postgrest
VITE_SIMETRA_DATA_PROVIDER=mock

# Обов'язково, якщо VITE_SIMETRA_DATA_PROVIDER=postgrest
VITE_SIMETRA_API_URL=http://localhost:3000

# Опціонально для Supabase/PostgREST із ключем
VITE_SIMETRA_ANON_KEY=
