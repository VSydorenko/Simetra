{
  "$schema": "https://simetra.dev/schemas/v1/catalog.schema.json",
  "kind": "Catalog",
  "name": "Products",
  "displayName": {
    "uk": "Товари",
    "en": "Products"
  },
  "codeLength": 9,
  "codeType": "String",
