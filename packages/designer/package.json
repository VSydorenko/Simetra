{
  "name": "@simetrajs/designer",
  "version": "0.1.0",
  "description": "Simetra developer tools: command line and MCP server over the metadata compiler",
  "keywords": [
    "simetra",
    "metadata",
    "postgres",
    "cli",
    "mcp",
    "schema"
  ],
  "homepage": "https://github.com/VSydorenko/Simetra#readme",
  "bugs": "https://github.com/VSydorenko/Simetra/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VSydorenko/Simetra.git",
    "directory": "packages/designer"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "skills"
  ],
  "bin": {
    "simetra": "bin/simetra.mjs"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:package": "tsdown",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:packaging": "vitest run --project packaging"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@supabase/pg-delta": "1.0.0-alpha.56",
    "citty": "0.2.2",
    "pg": "8.23.1",
    "simetra": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "simetra": "./dist/main.js"
    }
  }
}
