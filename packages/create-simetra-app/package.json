{
  "name": "create-simetra-app",
  "version": "0.0.0",
  "private": true,
  "description": "Application template for Simetra hosts on TanStack Start",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "demo": "node scripts/demo.mts",
    "demo:drop": "node scripts/demo.mts drop",
    "test:build": "vitest run --config vitest.build.config.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:gate": "node e2e/playwright-gate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-auth": "1.7.12",
    "eslint": "^10.14.0",
    "pg": "8.23.1",
    "simetra": "workspace:*",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
