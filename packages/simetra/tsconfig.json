{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "scripts", "bench"],
  // DOM-типи — лише в `tsconfig.dom.json`: інакше DOM-глобали бачив би і T0
  "exclude": ["node_modules", "dist", "src/ui", "src/data/react"]
}
