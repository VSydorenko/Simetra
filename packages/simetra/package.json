{
  "name": "simetra",
  "version": "0.2.0",
  "description": "Metadata-driven platform for business applications on Postgres: metamodel, compiler and schema engine",
  "keywords": [
    "metadata",
    "business-applications",
    "postgres",
    "postgresql",
    "schema",
    "compiler",
    "typescript"
  ],
  "homepage": "https://github.com/VSydorenko/Simetra#readme",
  "bugs": "https://github.com/VSydorenko/Simetra/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VSydorenko/Simetra.git",
    "directory": "packages/simetra"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "build:package": "tsdown",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json",
    "test": "vitest run --project unit",
    "test:docs": "vitest run --project unit .docs.test.",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:db:supabase": "vitest run --project db-supabase",
    "schemas:update": "UPDATE_JSON_SCHEMAS=1 vitest run --project unit json-schema",
    "bench:rights": "vitest run --project bench rights",
    "bench:tabular": "vitest run --project bench tabular",
    "catalog-functions": "node scripts/catalog-functions.ts",
    "builtin-functions": "node scripts/builtin-functions.ts"
  },
  "dependencies": {
    "@libpg-query/parser": "17.8.0",
    "jsonc-parser": "3.3.1",
    "libpg-query": "17.8.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "centrifuge": "^5.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "centrifuge": {
      "optional": true
    },
    "@tanstack/react-form": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "better-auth": "1.7.12",
    "centrifuge": "5.8.0",
    "eslint": "^10.14.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.5",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./model": "./src/model/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./schema": "./src/schema/index.ts",
    "./server": "./src/server/index.ts",
    "./server/signals": "./src/server/signals/index.ts",
    "./data": "./src/data/index.ts",
    "./data/react": "./src/data/react/index.ts",
    "./data/centrifugo": "./src/data/centrifugo/index.ts",
    "./ui": "./src/ui/index.ts",
    "./shell": "./src/shell/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./model": {
        "types": "./dist/model/index.d.ts",
        "import": "./dist/model/index.js"
      },
      "./compiler": {
        "types": "./dist/compiler/index.d.ts",
        "import": "./dist/compiler/index.js"
      },
      "./schema": {
        "types": "./dist/schema/index.d.ts",
        "import": "./dist/schema/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./server/signals": {
        "types": "./dist/server/signals/index.d.ts",
        "import": "./dist/server/signals/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "import": "./dist/data/index.js"
      },
      "./data/react": {
        "types": "./dist/data/react/index.d.ts",
        "import": "./dist/data/react/index.js"
      },
      "./data/centrifugo": {
        "types": "./dist/data/centrifugo/index.d.ts",
        "import": "./dist/data/centrifugo/index.js"
      },
      "./ui": {
        "types": "./dist/ui/index.d.ts",
        "import": "./dist/ui/index.js"
      },
      "./shell": {
        "types": "./dist/shell/index.d.ts",
        "import": "./dist/shell/index.js"
      },
      "./schemas/*": "./schemas/*"
    }
  }
}
