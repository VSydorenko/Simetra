{
  "name": "simetra",
  "version": "0.2.0",
  "description": "Metadata-driven platform for business applications on Postgres: metamodel, compiler and schema engine",
  "keywords": [
    "metadata",
    "business-applications",
    "postgres",
    "postgresql",
    "schema",
    "compiler",
    "typescript"
  ],
  "homepage": "https://github.com/VSydorenko/Simetra#readme",
  "bugs": "https://github.com/VSydorenko/Simetra/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VSydorenko/Simetra.git",
    "directory": "packages/simetra"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "build:package": "tsdown",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:db:pg": "vitest run --project db-pg",
    "test:db:supabase": "vitest run --project db-supabase --passWithNoTests",
    "schemas:update": "UPDATE_JSON_SCHEMAS=1 vitest run --project unit json-schema",
    "bench:rights": "vitest run --project bench",
    "catalog-functions": "node scripts/catalog-functions.ts",
    "builtin-functions": "node scripts/builtin-functions.ts"
  },
  "dependencies": {
    "@libpg-query/parser": "17.8.0",
    "jsonc-parser": "3.3.1",
    "libpg-query": "17.8.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "tsdown": "0.23.5",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./model": "./src/model/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./schema": "./src/schema/index.ts",
    "./server": "./src/server/index.ts",
    "./data": "./src/data/index.ts",
    "./ui": "./src/ui/index.ts",
    "./shell": "./src/shell/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./model": {
        "types": "./dist/model/index.d.ts",
        "import": "./dist/model/index.js"
      },
      "./compiler": {
        "types": "./dist/compiler/index.d.ts",
        "import": "./dist/compiler/index.js"
      },
      "./schema": {
        "types": "./dist/schema/index.d.ts",
        "import": "./dist/schema/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "import": "./dist/data/index.js"
      },
      "./schemas/*": "./schemas/*"
    }
  }
}
