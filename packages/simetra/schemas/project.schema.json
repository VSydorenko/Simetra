{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint: path to the JSON Schema of this file.",
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Application name."
    },
    "title": {
      "description": "Human-readable title of the application.",
      "type": "object",
      "properties": {
        "uk": {
          "description": "Ukrainian text.",
          "type": "string"
        },
        "en": {
          "description": "English text.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "defaultLocale": {
      "default": "uk",
      "description": "Locale used when none is requested.",
      "type": "string",
      "enum": [
        "uk",
        "en"
      ]
    },
    "defaultSchema": {
      "default": "public",
      "description": "PostgreSQL schema for objects that declare none.",
      "type": "string"
    },
    "database": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "supabase"
          ],
          "description": "Database provider preset that defines the management boundary."
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false,
      "description": "Database of the application."
    },
    "naming": {
      "default": {
        "attributeCase": "camelCase"
      },
      "description": "Naming rules of the application.",
      "type": "object",
      "properties": {
        "attributeCase": {
          "default": "camelCase",
          "description": "Casing style of logical attribute names.",
          "type": "string",
          "enum": [
            "camelCase",
            "snake_case"
          ]
        }
      },
      "additionalProperties": false
    },
    "timezone": {
      "default": "UTC",
      "description": "IANA time zone in which the platform determines day, month, quarter and year.",
      "type": "string",
      "minLength": 1
    },
    "scopeKinds": {
      "default": [],
      "description": "Scope kinds of the application; leave empty for a single-tenant application.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
          },
          "physicalName": {
            "type": "string",
            "minLength": 1,
            "description": "Physical database name. Assigned once at creation and never changed, so a rename emits no DDL. At most 63 bytes in UTF-8."
          },
          "title": {
            "description": "Human-readable title of the scope kind.",
            "type": "object",
            "properties": {
              "uk": {
                "description": "Ukrainian text.",
                "type": "string"
              },
              "en": {
                "description": "English text.",
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "root": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "object": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "Catalog",
                          "Document",
                          "Enumeration",
                          "InformationRegister",
                          "AccumulationRegister",
                          "Constant",
                          "CustomTable",
                          "PgEnum",
                          "EventSubscription",
                          "RightsSet",
                          "Role"
                        ],
                        "description": "Kind of the referenced metadata object."
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Za-z0-9]*$",
                        "description": "Logical name of the referenced object."
                      }
                    },
                    "required": [
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false,
                    "description": "Metadata object that is the scope root."
                  }
                },
                "required": [
                  "object"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "external": {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "type": "string",
                        "minLength": 1,
                        "description": "PostgreSQL schema of the external root table."
                      },
                      "table": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Physical name of the external root table."
                      },
                      "column": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Physical key column of the external root table."
                      }
                    },
                    "required": [
                      "schema",
                      "table",
                      "column"
                    ],
                    "additionalProperties": false,
                    "description": "Root table outside the metadata."
                  }
                },
                "required": [
                  "external"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Root of the scope: a metadata object or an external table."
          },
          "setFunction": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "schema": {
                    "description": "PostgreSQL schema of the function; defaultSchema when absent.",
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Physical name of the function."
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "description": "SQL function defined in a .sql file."
              },
              {
                "type": "string",
                "const": "membership",
                "description": "Generated from the membership catalog of this scope kind: the scope values where the current user is a member."
              }
            ],
            "description": "SQL function that returns the set of scope values visible to the current user."
          },
          "onRootDelete": {
            "default": "restrict",
            "description": "What happens to scoped rows when the scope root is deleted.",
            "type": "string",
            "enum": [
              "restrict",
              "cascade"
            ]
          }
        },
        "required": [
          "name",
          "root",
          "setFunction"
        ],
        "additionalProperties": false,
        "description": "Scope kind of the application (tenant dimension)."
      }
    },
    "accessDimensions": {
      "default": [],
      "description": "Access dimensions of the application: value catalogs that grants may restrict rows by.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Logical name of the access dimension, unique among all named elements of the project."
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "Catalog",
                  "Document",
                  "Enumeration",
                  "InformationRegister",
                  "AccumulationRegister",
                  "Constant",
                  "CustomTable",
                  "PgEnum",
                  "EventSubscription",
                  "RightsSet",
                  "Role"
                ],
                "description": "Kind of the referenced metadata object."
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "description": "Logical name of the referenced object."
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false,
            "description": "Catalog of the dimension values; scoped when the project has scope kinds."
          },
          "values": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "relation": {
                    "type": "object",
                    "properties": {
                      "object": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "Catalog",
                              "Document",
                              "Enumeration",
                              "InformationRegister",
                              "AccumulationRegister",
                              "Constant",
                              "CustomTable",
                              "PgEnum",
                              "EventSubscription",
                              "RightsSet",
                              "Role"
                            ],
                            "description": "Kind of the referenced metadata object."
                          },
                          "name": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Za-z0-9]*$",
                            "description": "Logical name of the referenced object."
                          }
                        },
                        "required": [
                          "kind",
                          "name"
                        ],
                        "additionalProperties": false,
                        "description": "Object whose rows link a user or a member to a value of the dimension."
                      },
                      "subject": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                        "description": "Reference of the relation object to the users catalog or to the membership catalog."
                      },
                      "value": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                        "description": "Reference of the relation object to the target catalog."
                      }
                    },
                    "required": [
                      "object",
                      "subject",
                      "value"
                    ],
                    "additionalProperties": false,
                    "description": "Values of a user read from a relation."
                  }
                },
                "required": [
                  "relation"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "function": {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "description": "PostgreSQL schema of the function; the project default schema when omitted.",
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Name of a verbatim SQL function that returns the value ids of the current user."
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "description": "Values of a user returned by a function."
                  }
                },
                "required": [
                  "function"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Where the values of the current user come from."
          }
        },
        "required": [
          "name",
          "target",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "membershipSources": {
      "default": [],
      "description": "Adopted tables that hold the membership of a scope kind instead of a membership catalog.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Logical name of the membership source, unique among all named elements of the project."
          },
          "scopeKind": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Name of the project scope kind whose membership the table holds."
          },
          "table": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "Catalog",
                  "Document",
                  "Enumeration",
                  "InformationRegister",
                  "AccumulationRegister",
                  "Constant",
                  "CustomTable",
                  "PgEnum",
                  "EventSubscription",
                  "RightsSet",
                  "Role"
                ],
                "description": "Kind of the referenced metadata object."
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "description": "Logical name of the referenced object."
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false,
            "description": "Adopted table (CustomTable) with the membership rows."
          },
          "columns": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "description": "Column with the scope value."
              },
              "user": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "description": "Column with the user id."
              },
              "active": {
                "description": "Boolean column; only active rows count as membership.",
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "scope",
              "user"
            ],
            "additionalProperties": false,
            "description": "Logical names of the table columns."
          },
          "where": {
            "default": [],
            "description": "Conditions every row of the source must meet (a conjunction); rows that fail them are not part of the source.",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                      "description": "Logical name of a column of the table."
                    },
                    "equals": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      ],
                      "description": "Literal the column must equal: a string for a text or uuid column, a boolean, or an integer."
                    }
                  },
                  "required": [
                    "column",
                    "equals"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                      "description": "Logical name of a column of the table."
                    },
                    "isNull": {
                      "type": "boolean",
                      "description": "true: the column must be NULL; false: must not be NULL."
                    }
                  },
                  "required": [
                    "column",
                    "isNull"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "Condition on a row of the table: a column equals a literal or is (not) NULL."
            }
          }
        },
        "required": [
          "name",
          "scopeKind",
          "table",
          "columns"
        ],
        "additionalProperties": false
      }
    },
    "assignmentSources": {
      "default": [],
      "description": "Adopted tables that hold role assignments of one level.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Logical name of the assignment source, unique among all named elements of the project."
          },
          "assignedOn": {
            "anyOf": [
              {
                "type": "string",
                "const": "global"
              },
              {
                "type": "object",
                "properties": {
                  "scopeKind": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "description": "Name of the project scope kind of the level."
                  }
                },
                "required": [
                  "scopeKind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "container": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "Catalog",
                          "Document",
                          "Enumeration",
                          "InformationRegister",
                          "AccumulationRegister",
                          "Constant",
                          "CustomTable",
                          "PgEnum",
                          "EventSubscription",
                          "RightsSet",
                          "Role"
                        ],
                        "description": "Kind of the referenced metadata object."
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Za-z0-9]*$",
                        "description": "Logical name of the referenced object."
                      }
                    },
                    "required": [
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false,
                    "description": "Rights container object of the level."
                  }
                },
                "required": [
                  "container"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Level of the assignment: global, a scope kind or a rights container."
          },
          "table": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "Catalog",
                  "Document",
                  "Enumeration",
                  "InformationRegister",
                  "AccumulationRegister",
                  "Constant",
                  "CustomTable",
                  "PgEnum",
                  "EventSubscription",
                  "RightsSet",
                  "Role"
                ],
                "description": "Kind of the referenced metadata object."
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "description": "Logical name of the referenced object."
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false,
            "description": "Adopted table (CustomTable) with the assignment rows."
          },
          "columns": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "description": "Column with the member (a user for the global level)."
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "column": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                        "description": "Column of the source table with the uuid reference to the role table."
                      },
                      "references": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "Catalog",
                              "Document",
                              "Enumeration",
                              "InformationRegister",
                              "AccumulationRegister",
                              "Constant",
                              "CustomTable",
                              "PgEnum",
                              "EventSubscription",
                              "RightsSet",
                              "Role"
                            ],
                            "description": "Kind of the referenced metadata object."
                          },
                          "name": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Za-z0-9]*$",
                            "description": "Logical name of the referenced object."
                          }
                        },
                        "required": [
                          "kind",
                          "name"
                        ],
                        "additionalProperties": false,
                        "description": "Adopted role table (CustomTable) with a single-column uuid key."
                      },
                      "key": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                        "description": "Column of the role table with the role key declared by a role in sourceKeys."
                      },
                      "where": {
                        "default": [],
                        "description": "Conditions every row of the role table must meet (a conjunction); required unless the key column is unique on its own.",
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "column": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                                  "description": "Logical name of a column of the table."
                                },
                                "equals": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "boolean"
                                    },
                                    {
                                      "type": "integer",
                                      "minimum": -9007199254740991,
                                      "maximum": 9007199254740991
                                    }
                                  ],
                                  "description": "Literal the column must equal: a string for a text or uuid column, a boolean, or an integer."
                                }
                              },
                              "required": [
                                "column",
                                "equals"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "column": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                                  "description": "Logical name of a column of the table."
                                },
                                "isNull": {
                                  "type": "boolean",
                                  "description": "true: the column must be NULL; false: must not be NULL."
                                }
                              },
                              "required": [
                                "column",
                                "isNull"
                              ],
                              "additionalProperties": false
                            }
                          ],
                          "description": "Condition on a row of the table: a column equals a literal or is (not) NULL."
                        }
                      }
                    },
                    "required": [
                      "column",
                      "references",
                      "key"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "Column with the role key declared by a role in sourceKeys, or a reference to an adopted role table with the key column."
              },
              "scope": {
                "description": "Scope level only: column with the scope of the row, which must equal the scope of the member; null takes the scope from the member; omitted means the scopeColumn of the table.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "container": {
                "description": "Column with the container; required for the container level only.",
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              },
              "active": {
                "description": "Boolean column; only active rows count as assignments.",
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "member",
              "role"
            ],
            "additionalProperties": false,
            "description": "Logical names of the table columns."
          },
          "where": {
            "default": [],
            "description": "Conditions every row of the source must meet (a conjunction); rows that fail them are not part of the source.",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                      "description": "Logical name of a column of the table."
                    },
                    "equals": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      ],
                      "description": "Literal the column must equal: a string for a text or uuid column, a boolean, or an integer."
                    }
                  },
                  "required": [
                    "column",
                    "equals"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
