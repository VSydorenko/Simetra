{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint: path to the JSON Schema of this file.",
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "description": "Logical object name in PascalCase."
    },
    "physicalName": {
      "type": "string",
      "minLength": 1,
      "description": "Physical database name. Assigned once at creation and never changed, so a rename emits no DDL. At most 63 bytes in UTF-8."
    },
    "schema": {
      "description": "PostgreSQL schema of the object; the project defaultSchema applies when absent.",
      "type": "string"
    },
    "scope": {
      "description": "Scope kind of the object, or none to keep it outside any scope. Required when the project declares scope kinds.",
      "type": "string"
    },
    "title": {
      "description": "Human-readable title of the object.",
      "type": "object",
      "properties": {
        "uk": {
          "description": "Ukrainian text.",
          "type": "string"
        },
        "en": {
          "description": "English text.",
          "type": "string"
        }
      }
    },
    "description": {
      "description": "Description of the object.",
      "type": "object",
      "properties": {
        "uk": {
          "description": "Ukrainian text.",
          "type": "string"
        },
        "en": {
          "description": "English text.",
          "type": "string"
        }
      }
    },
    "kind": {
      "type": "string",
      "const": "Constant",
      "description": "Metadata kind; always Constant."
    },
    "type": {
      "type": "string",
      "enum": [
        "UUID",
        "String",
        "Text",
        "Integer",
        "SmallInt",
        "BigInt",
        "Numeric",
        "Boolean",
        "Date",
        "DateTime",
        "Bytes",
        "Json",
        "Ref"
      ],
      "description": "Logical value type."
    },
    "length": {
      "description": "Maximum length; required for String and allowed only there.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "precision": {
      "description": "Total number of digits; allowed only for Numeric.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "scale": {
      "description": "Digits after the decimal point; requires precision.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ref": {
      "description": "Single reference target of a Ref value; mutually exclusive with allowedTypes.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Catalog",
            "Document",
            "Enumeration",
            "InformationRegister",
            "AccumulationRegister",
            "Constant",
            "CustomTable",
            "PgEnum"
          ],
          "description": "Kind of the referenced metadata object."
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "description": "Logical name of the referenced object."
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "allowedTypes": {
      "description": "Polymorphic reference targets of a Ref value; mutually exclusive with ref.",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Catalog",
              "Document",
              "Enumeration",
              "InformationRegister",
              "AccumulationRegister",
              "Constant",
              "CustomTable",
              "PgEnum"
            ],
            "description": "Kind of the referenced metadata object."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "description": "Logical name of the referenced object."
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "description": "Reference to a metadata object by kind and logical name; the compiler resolves it to an id."
      }
    },
    "array": {
      "description": "Whether the value is an array of the type.",
      "type": "boolean"
    },
    "crossScope": {
      "description": "Marks a deliberately cross-scope Ref: the FK has no scope part in its key.",
      "type": "boolean",
      "const": true
    },
    "defaultValue": {
      "description": "Initial value of the constant.",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    }
  },
  "required": [
    "name",
    "kind",
    "type"
  ],
  "$id": "constants.schema.json"
}
