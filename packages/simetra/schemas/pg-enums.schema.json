{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint: path to the JSON Schema of this file.",
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "description": "Logical object name in PascalCase."
    },
    "physicalName": {
      "type": "string",
      "minLength": 1,
      "description": "Physical database name. Assigned once at creation and never changed, so a rename emits no DDL. At most 63 bytes in UTF-8."
    },
    "schema": {
      "description": "PostgreSQL schema of the object; the project defaultSchema applies when absent.",
      "type": "string"
    },
    "title": {
      "description": "Human-readable title of the object.",
      "type": "object",
      "properties": {
        "uk": {
          "description": "Ukrainian text.",
          "type": "string"
        },
        "en": {
          "description": "English text.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "description": "Description of the object.",
      "type": "object",
      "properties": {
        "uk": {
          "description": "Ukrainian text.",
          "type": "string"
        },
        "en": {
          "description": "English text.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "const": "PgEnum",
      "description": "Metadata kind; always PgEnum."
    },
    "values": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Physical enum labels in database order; duplicates are not allowed."
    }
  },
  "required": [
    "name",
    "kind",
    "values"
  ],
  "additionalProperties": false,
  "$id": "pg-enums.schema.json"
}
