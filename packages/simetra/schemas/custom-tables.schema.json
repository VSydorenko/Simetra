{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint: path to the JSON Schema of this file.",
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "description": "Logical object name in PascalCase."
    },
    "physicalName": {
      "type": "string",
      "minLength": 1,
      "description": "Physical database name. Assigned once at creation and never changed, so a rename emits no DDL. At most 63 bytes in UTF-8."
    },
    "schema": {
      "description": "PostgreSQL schema of the object; the project defaultSchema applies when absent.",
      "type": "string"
    },
    "scope": {
      "description": "Scope kind of the object, or none to keep it outside any scope. Required when the project declares scope kinds.",
      "type": "string"
    },
    "title": {
      "description": "Human-readable title of the object.",
      "type": "object",
      "properties": {
        "uk": {
          "description": "Ukrainian text.",
          "type": "string"
        },
        "en": {
          "description": "English text.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "description": "Description of the object.",
      "type": "object",
      "properties": {
        "uk": {
          "description": "Ukrainian text.",
          "type": "string"
        },
        "en": {
          "description": "English text.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "const": "CustomTable",
      "description": "Metadata kind; always CustomTable."
    },
    "kindLabel": {
      "description": "Physical kind label of the object. Assigned once at creation and never changed, so a rename keeps it.",
      "type": "string",
      "minLength": 1
    },
    "comment": {
      "description": "Comment on the table.",
      "type": "string"
    },
    "columns": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
            "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
          },
          "physicalName": {
            "type": "string",
            "minLength": 1,
            "description": "Physical database name. Assigned once at creation and never changed, so a rename emits no DDL. At most 63 bytes in UTF-8."
          },
          "title": {
            "description": "Human-readable title of the column.",
            "type": "object",
            "properties": {
              "uk": {
                "description": "Ukrainian text.",
                "type": "string"
              },
              "en": {
                "description": "English text.",
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "notNull": {
            "default": false,
            "description": "Whether the column is NOT NULL.",
            "type": "boolean"
          },
          "default": {
            "description": "SQL expression used as the column default.",
            "type": "string"
          },
          "identity": {
            "description": "Identity generation mode; requires SmallInt, Integer or BigInt type.",
            "type": "string",
            "enum": [
              "always",
              "byDefault"
            ]
          },
          "generated": {
            "description": "Stored generated column; incompatible with default and identity.",
            "type": "object",
            "properties": {
              "expression": {
                "type": "string",
                "minLength": 1,
                "description": "SQL expression of the stored generated column."
              }
            },
            "required": [
              "expression"
            ],
            "additionalProperties": false
          },
          "collation": {
            "description": "Collation of the column (pg_collation); absent means the type default.",
            "type": "object",
            "properties": {
              "schema": {
                "description": "Schema of the object, unquoted; omitted for objects in pg_catalog.",
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Name of the object, unquoted, as Postgres reports it."
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "comment": {
            "description": "Comment on the column.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "UUID",
              "String",
              "Text",
              "Integer",
              "SmallInt",
              "BigInt",
              "Numeric",
              "Boolean",
              "Date",
              "DateTime",
              "Bytes",
              "Json",
              "Ref",
              "PgEnum",
              "Raw"
            ],
            "description": "Logical type, PgEnum for an accepted enum, or Raw for a raw PostgreSQL type."
          },
          "length": {
            "description": "Maximum length; required for String and allowed only there.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "precision": {
            "description": "Total number of digits; allowed only for Numeric.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "scale": {
            "description": "Digits after the decimal point; requires precision.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ref": {
            "description": "Single reference target of a Ref value; mutually exclusive with allowedTypes.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "Catalog",
                  "Document",
                  "Enumeration",
                  "InformationRegister",
                  "AccumulationRegister",
                  "Constant",
                  "CustomTable",
                  "PgEnum"
                ],
                "description": "Kind of the referenced metadata object."
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "description": "Logical name of the referenced object."
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          },
          "allowedTypes": {
            "description": "Polymorphic reference targets of a Ref value; mutually exclusive with ref.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "Catalog",
                    "Document",
                    "Enumeration",
                    "InformationRegister",
                    "AccumulationRegister",
                    "Constant",
                    "CustomTable",
                    "PgEnum"
                  ],
                  "description": "Kind of the referenced metadata object."
                },
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*$",
                  "description": "Logical name of the referenced object."
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false,
              "description": "Reference to a metadata object by kind and logical name; the compiler resolves it to an id."
            }
          },
          "array": {
            "description": "Whether the value is an array of the type.",
            "type": "boolean"
          },
          "enum": {
            "description": "Enum type of a PgEnum column.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "PgEnum",
                "description": "Always PgEnum."
              },
              "name": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "description": "Logical name of the PgEnum object."
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          },
          "pgType": {
            "description": "Raw PostgreSQL type of a Raw column.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      },
      "description": "Columns of the table."
    },
    "primaryKey": {
      "description": "Primary key of the table.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Constraint name; when absent the PostgreSQL default name is used.",
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
          },
          "description": "Logical names of columns of this table."
        },
        "deferrable": {
          "default": "no",
          "description": "Whether the constraint check can be deferred.",
          "type": "string",
          "enum": [
            "no",
            "deferrable",
            "initiallyDeferred"
          ]
        }
      },
      "required": [
        "columns"
      ],
      "additionalProperties": false
    },
    "uniques": {
      "default": [],
      "description": "Unique constraints of the table.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Constraint name; when absent the PostgreSQL default name is used.",
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
            },
            "description": "Logical names of columns of this table."
          },
          "nullsNotDistinct": {
            "default": false,
            "description": "Whether NULLs are treated as equal.",
            "type": "boolean"
          },
          "deferrable": {
            "default": "no",
            "description": "Whether the constraint check can be deferred.",
            "type": "string",
            "enum": [
              "no",
              "deferrable",
              "initiallyDeferred"
            ]
          }
        },
        "required": [
          "columns"
        ],
        "additionalProperties": false,
        "description": "Unique constraint."
      }
    },
    "checks": {
      "default": [],
      "description": "Check constraints of the table.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Constraint name; when absent the PostgreSQL default name is used.",
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "description": "SQL boolean expression of the check."
          }
        },
        "required": [
          "expression"
        ],
        "additionalProperties": false,
        "description": "Check constraint."
      }
    },
    "foreignKeys": {
      "default": [],
      "description": "Foreign keys of the table.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Constraint name; when absent the PostgreSQL default name is used.",
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
            },
            "description": "Logical names of columns of this table."
          },
          "references": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "object": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "Catalog",
                          "Document",
                          "Enumeration",
                          "InformationRegister",
                          "AccumulationRegister",
                          "Constant",
                          "CustomTable",
                          "PgEnum"
                        ],
                        "description": "Kind of the referenced metadata object."
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Za-z0-9]*$",
                        "description": "Logical name of the referenced object."
                      }
                    },
                    "required": [
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false,
                    "description": "Referenced metadata object."
                  },
                  "columns": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                      "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
                    },
                    "description": "Logical names of columns of the referenced object."
                  }
                },
                "required": [
                  "object",
                  "columns"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "external": {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "type": "string",
                        "minLength": 1,
                        "description": "PostgreSQL schema of the external table."
                      },
                      "table": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Physical name of the external table."
                      },
                      "columns": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": "Physical column names of the external table."
                      }
                    },
                    "required": [
                      "schema",
                      "table",
                      "columns"
                    ],
                    "additionalProperties": false,
                    "description": "Referenced table outside the metadata."
                  }
                },
                "required": [
                  "external"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Referenced target: a metadata object or an external table."
          },
          "onDelete": {
            "default": "noAction",
            "description": "Action on delete of the referenced row.",
            "type": "string",
            "enum": [
              "noAction",
              "restrict",
              "cascade",
              "setNull",
              "setDefault"
            ]
          },
          "onUpdate": {
            "default": "noAction",
            "description": "Action on update of the referenced key.",
            "type": "string",
            "enum": [
              "noAction",
              "restrict",
              "cascade",
              "setNull",
              "setDefault"
            ]
          },
          "deferrable": {
            "default": "no",
            "description": "Whether the constraint check can be deferred.",
            "type": "string",
            "enum": [
              "no",
              "deferrable",
              "initiallyDeferred"
            ]
          }
        },
        "required": [
          "columns",
          "references"
        ],
        "additionalProperties": false,
        "description": "Foreign key of the table."
      }
    },
    "indexes": {
      "default": [],
      "description": "Indexes of the table.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Constraint name; when absent the PostgreSQL default name is used.",
            "type": "string",
            "minLength": 1
          },
          "unique": {
            "default": false,
            "description": "Whether the index is unique.",
            "type": "boolean"
          },
          "method": {
            "default": "btree",
            "description": "Index access method.",
            "type": "string",
            "minLength": 1
          },
          "keys": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                      "description": "Logical name of the indexed column."
                    },
                    "order": {
                      "description": "Sort order of the key; absent means ascending.",
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    },
                    "nulls": {
                      "description": "NULLS FIRST or NULLS LAST; absent means the order default.",
                      "type": "string",
                      "enum": [
                        "first",
                        "last"
                      ]
                    },
                    "opclass": {
                      "description": "Operator class of the key (pg_opclass); absent means the type default.",
                      "type": "object",
                      "properties": {
                        "schema": {
                          "description": "Schema of the object, unquoted; omitted for objects in pg_catalog.",
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Name of the object, unquoted, as Postgres reports it."
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    "collation": {
                      "description": "Collation of the key (pg_collation); absent means the column default.",
                      "type": "object",
                      "properties": {
                        "schema": {
                          "description": "Schema of the object, unquoted; omitted for objects in pg_catalog.",
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Name of the object, unquoted, as Postgres reports it."
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "expression": {
                      "type": "string",
                      "minLength": 1,
                      "description": "SQL expression of the index key."
                    },
                    "order": {
                      "description": "Sort order of the key; absent means ascending.",
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    },
                    "nulls": {
                      "description": "NULLS FIRST or NULLS LAST; absent means the order default.",
                      "type": "string",
                      "enum": [
                        "first",
                        "last"
                      ]
                    },
                    "opclass": {
                      "description": "Operator class of the key (pg_opclass); absent means the type default.",
                      "type": "object",
                      "properties": {
                        "schema": {
                          "description": "Schema of the object, unquoted; omitted for objects in pg_catalog.",
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Name of the object, unquoted, as Postgres reports it."
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    "collation": {
                      "description": "Collation of the key (pg_collation); absent means the column default.",
                      "type": "object",
                      "properties": {
                        "schema": {
                          "description": "Schema of the object, unquoted; omitted for objects in pg_catalog.",
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Name of the object, unquoted, as Postgres reports it."
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "expression"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Index keys: columns or expressions."
          },
          "include": {
            "default": [],
            "description": "Logical names of non-key columns stored in the index.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "description": "Logical element name (attribute, section, column). The casing style is checked against the project naming setting."
            }
          },
          "where": {
            "description": "SQL predicate of a partial index.",
            "type": "string"
          },
          "nullsNotDistinct": {
            "default": false,
            "description": "Whether NULLs are treated as equal in a unique index.",
            "type": "boolean"
          }
        },
        "required": [
          "keys"
        ],
        "additionalProperties": false,
        "description": "Index of the table."
      }
    },
    "scopeColumn": {
      "description": "Logical name of the own column that carries the scope.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "rowLevelSecurity": {
      "default": "off",
      "description": "Row-level security of the table: off, enabled, or forced (applies to the table owner too).",
      "type": "string",
      "enum": [
        "off",
        "enabled",
        "forced"
      ]
    }
  },
  "required": [
    "name",
    "kind",
    "columns"
  ],
  "additionalProperties": false,
  "$id": "custom-tables.schema.json"
}
