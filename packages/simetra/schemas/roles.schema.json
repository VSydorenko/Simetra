{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Editor hint: path to the JSON Schema of this file.",
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "description": "Stable lowercase UUID v4 identity of the element. Assigned by tooling at creation and never reused; a rename keeps it."
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "description": "Logical object name in PascalCase."
    },
    "kind": {
      "type": "string",
      "const": "Role",
      "description": "Metadata kind; always Role."
    },
    "assignedOn": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "const": "global"
            },
            {
              "type": "object",
              "properties": {
                "scopeKind": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                  "description": "Name of the project scope kind of the level."
                }
              },
              "required": [
                "scopeKind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "container": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "Catalog",
                        "Document",
                        "Enumeration",
                        "InformationRegister",
                        "AccumulationRegister",
                        "Constant",
                        "CustomTable",
                        "PgEnum",
                        "EventSubscription",
                        "RightsSet",
                        "Role"
                      ],
                      "description": "Kind of the referenced metadata object."
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Za-z0-9]*$",
                      "description": "Logical name of the referenced object."
                    }
                  },
                  "required": [
                    "kind",
                    "name"
                  ],
                  "additionalProperties": false,
                  "description": "Rights container object of the level."
                }
              },
              "required": [
                "container"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Level of the assignment: global, a scope kind or a rights container."
        },
        {
          "type": "string",
          "const": "everyUser",
          "description": "Every authenticated user, with no assignment rows."
        }
      ],
      "description": "Level of the role: global, every user, a scope kind or a rights container."
    },
    "fullAccess": {
      "default": false,
      "description": "Bypass the rights checks on the objects of the role level; not on a container role or every user.",
      "type": "boolean"
    },
    "order": {
      "description": "Position of the role in the rights matrix.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assignable": {
      "default": true,
      "description": "Whether administrators assign the role; an owner role is handed over by its own command.",
      "type": "boolean"
    },
    "maxHolders": {
      "description": "Most holders of the role on one level value.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rootCreator": {
      "default": false,
      "description": "Scope level only: the command that creates a scope root assigns this role to its creator.",
      "type": "boolean"
    },
    "sourceKeys": {
      "default": [],
      "description": "Keys that name this role in adopted assignment sources.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "Name of a project assignment source of the same level."
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Role key in the role column of the source."
          }
        },
        "required": [
          "source",
          "key"
        ],
        "additionalProperties": false
      }
    },
    "include": {
      "default": [],
      "description": "Rights sets whose grants this declaration includes.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Catalog",
              "Document",
              "Enumeration",
              "InformationRegister",
              "AccumulationRegister",
              "Constant",
              "CustomTable",
              "PgEnum",
              "EventSubscription",
              "RightsSet",
              "Role"
            ],
            "description": "Kind of the referenced metadata object."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$",
            "description": "Logical name of the referenced object."
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false,
        "description": "Reference to a metadata object by kind and logical name; the compiler resolves it to an id."
      }
    }
  },
  "required": [
    "name",
    "kind",
    "assignedOn"
  ],
  "additionalProperties": false,
  "$id": "roles.schema.json"
}
