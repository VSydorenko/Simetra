    "numberLength": {
      "default": 11,
      "description": "Length of the document number.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "numberType": {
      "default": "String",
      "description": "Value type of the document number.",
      "type": "string",
      "enum": [
        "String",
        "Number"
      ]
    },
    "autonumber": {
      "default": true,
      "description": "Whether the number is generated automatically.",
      "type": "boolean"
    },
    "numberPeriodicity": {
      "default": "Year",
      "description": "Period after which automatic numbering restarts.",
      "type": "string",
      "enum": [
        "None",
        "Year",
        "Quarter",
        "Month",
        "Day"
      ]
    },
    "posting": {
      "description": "Posting declaration of the document.",
      "type": "object",
      "properties": {
        "movements": {
          "default": [],
          "description": "Declared movements written when the document is posted.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "register": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "Catalog",
                      "Document",
                      "Enumeration",
                      "InformationRegister",
                      "AccumulationRegister",
                      "Constant",
                      "CustomTable",
                      "PgEnum"
                    ],
                    "description": "Kind of the referenced metadata object."
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*$",
                    "description": "Logical name of the referenced object."
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "additionalProperties": false,
                "description": "Register that receives the movement."
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "document"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tabularSection": {
