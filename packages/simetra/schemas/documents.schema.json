                      "tabularSection"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "Where movement rows come from: the document itself or one of its tabular sections."
              },
              "condition": {
                "description": "Expression; the movement is written only when it is true.",
                "type": "string",
                "minLength": 1
              },
              "movementType": {
                "description": "Receipt or Expense literal for a balance register, otherwise an expression.",
                "type": "string",
                "minLength": 1
              },
              "period": {
                "description": "Expression for the movement period.",
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Register field name to expression; the register defines each field role."
              }
