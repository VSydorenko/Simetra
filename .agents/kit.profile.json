{
  "pr": {
    "base": "main",
    "mergeMethod": "merge",
    "waitTimeout": 1800
  },
  "tests": {
    "default": "unit",
    "packages": {
      "simetra": "packages/simetra",
      "designer": "packages/designer",
      "template": "packages/create-simetra-app/template",
      "e2e": "packages/create-simetra-app"
    },
    "levels": {
      "unit": {
        "command": [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--project",
          "unit"
        ],
        "reporter": "vitest-json",
        "packages": [
          "simetra",
          "designer",
          "template"
        ],
        "timeout": 900,
        "ci": true
      },
      "db": {
        "command": [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--project",
          "db"
        ],
        "reporter": "vitest-json",
        "packages": [
          "simetra",
          "designer",
          "template"
        ],
        "lock": "/tmp/simetra-db-stack-postgres.lock",
        "lockWait": 2700,
        "timeout": 2400,
        "ci": true
      },
      "db-supabase": {
        "command": [
          "pnpm",
          "exec",
          "vitest",
          "run",
          "--project",
          "db-supabase",
          "--passWithNoTests"
        ],
        "reporter": "vitest-json",
        "packages": [
          "simetra",
          "designer"
        ],
        "lock": "/tmp/simetra-db-stack.lock",
        "lockWait": 2700,
        "timeout": 1800,
        "ci": true
      },
      "e2e": {
        "command": [
          "pnpm",
          "run",
          "e2e"
        ],
        "reporter": "exit-code",
        "packages": [
          "e2e"
        ],
        "lock": "/tmp/simetra-db-stack-postgres.lock",
        "lockWait": 2700,
        "timeout": 1500,
        "ci": true
      }
    }
  },
  "docs": {
    "specs": "docs/superpowers/specs",
    "plans": "docs/superpowers/plans",
    "docs": "docs",
    "glossary": "docs/GLOSSARY.md",
    "adr": "docs/adr",
    "skills": [
      ".agents/skills",
      "packages/*/skills"
    ],
    "anchors": {
      "include": [
        "AGENTS.md",
        "CLAUDE.md",
        "README.md",
        "CONTRIBUTING.md",
        "docs/**/*.md",
        ".agents/**/*.md",
        "packages/*/skills/**/*.md",
        ".claude/**/*.md"
      ],
      "exclude": [
        "docs/research/**",
        "docs/superpowers/**"
      ],
      "roots": [
        "packages",
        "docs",
        "scripts",
        ".agents",
        ".claude",
        ".github",
        "supabase",
        "docker",
        "examples",
        "legacy"
      ],
      "external": [
        "MEMORY.md",
        "SKILL.md",
        "CLAUDE.local.md"
      ]
    }
  },
  "review": {
    "exclude": [
      "pnpm-lock.yaml",
      "**/*.snap"
    ],
    "criteria": ".agents/review-criteria.md"
  },
  "research": {
    "corpus": [
      "AGENTS.md",
      "CLAUDE.md",
      "README.md",
      "docs/**/*.md",
      ".agents/review-criteria.md",
      ".agents/skills/*/SKILL.md",
      "packages/*/README.md"
    ]
  },
  "format": {
    "check": [
      "pnpm",
      "exec",
      "prettier",
      "--check"
    ]
  },
  "kit": {
    "version": "0.8.0"
  }
}
