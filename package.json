{
  "name": "simetra",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source metadata-driven platform for business applications, in the spirit of 1C:Enterprise",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "test:db": "supabase test db",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:update": "pnpm update -r && syncpack fix"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.9.9",
    "supabase": "2.118.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=24"
  }
}
