{
  "name": "simetra-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source metadata-driven platform for business applications, in the spirit of 1C:Enterprise",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "build:packages": "NODE_OPTIONS=--max-old-space-size=3072 pnpm --filter simetra --filter @simetrajs/designer run build:package",
    "test:packaging": "pnpm --filter @simetrajs/designer test:packaging",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "db:start": "supabase start && pnpm db:dev-env",
    "db:dev-env": "node scripts/db-dev-env.mjs",
    "db:stop": "supabase stop",
    "db:pg:start": "node scripts/db-stack.mjs start postgres",
    "db:pg:stop": "node scripts/db-stack.mjs stop postgres",
    "test:db": "supabase test db && pnpm --filter simetra test:db && pnpm --filter @simetrajs/designer test:db",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=1",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:update": "pnpm update -r && syncpack fix",
    "metadata:check": "node packages/designer/bin/simetra.mjs compile --all",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "9.1.7",
    "prettier": "^3.9.10",
    "simetra": "workspace:*",
    "supabase": "2.122.1",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=24"
  }
}
