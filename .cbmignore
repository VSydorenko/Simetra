# Скоуп індексації коду для codebase-memory-mcp.
#
# .md/.mdx виключені навмисно: документацію обслуговує `orient --map`
# (BM25 по корпусу доків), а markdown у графі засмічує пошук символів.
*.md
*.mdx

# білд-артефакти й кеші (індексатор читає диск, а не git)
**/node_modules/
**/dist/
**/.turbo/
**/build/
**/coverage/
**/.cache/
**/*.tsbuildinfo
**/*.min.js

# службові теки: локальні проби метаданих і харнес агентів
temp/
.agents/
.claude/
