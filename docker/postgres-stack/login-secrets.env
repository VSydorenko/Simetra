# Dev passwords of the Simetra login roles of the postgres test stack: local
# stack on 127.0.0.1 only. Read by the start script, never by docker compose
# (an env_file would put them into a container); `db:pg:start` sets them after
# `simetra roles`.
SIMETRA_OWNER_DEV_PASSWORD=simetra-owner-dev
SIMETRA_RUNTIME_DEV_PASSWORD=simetra-runtime-dev
SIMETRA_AUTH_DEV_PASSWORD=simetra-auth-dev
